# Compose needs no .env. This file is for optional native development.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3000
SESSION_HOURS=12
TRUST_PROXY_HOPS=0
DATABASE_URL=
REDIS_URL=redis://localhost:6379
DEMO_PASSWORD=
# Set a generated secret of at least 32 characters for the native worker.
CERTIFICATE_LINK_SECRET=
CERTIFICATE_STORAGE=tmp/certificates
MOCK_WHATSAPP_MODE=mixed
