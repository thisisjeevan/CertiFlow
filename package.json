{
  "name": "certiflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=22.18 <25" },
  "scripts": {
    "dev:api": "npm run dev -w @certiflow/api",
    "dev:web": "npm run dev -w @certiflow/web",
    "dev:worker": "npm run dev:worker -w @certiflow/api",
    "db:generate": "npm run db:generate -w @certiflow/api",
    "db:migrate": "npm run db:migrate -w @certiflow/api",
    "db:seed": "npm run db:seed -w @certiflow/api",
    "build": "npm run db:generate && npm run build --workspaces",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run db:generate && npm run test -w @certiflow/api",
    "test:integration": "npm run db:generate && npm run test:integration -w @certiflow/api"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
